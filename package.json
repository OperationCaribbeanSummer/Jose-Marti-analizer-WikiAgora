    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "qr-code-styling": "^1.9.2",
    "redis": "^5.9.0",
    "redoc-express": "^2.1.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "@faker-js/faker": "^10.5.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "morgan": "^1.10.1",
    "semantic-release": "25.0.5",
    "standard": "^17.1.2",
    "supertest": "^7.1.4",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devRequirements": {
