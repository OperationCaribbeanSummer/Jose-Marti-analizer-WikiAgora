  "main": "app.js",
  "scripts": {
    "analyze": "webpack-bundle-analyzer dist/static/js/main.js",
    "backup": "node scripts/backup.js",
    "build": "npm run build:server",
    "build:server": "rimraf dist && babel src --out-dir dist --extensions .js,.jsx",
    "changelog:update": "auto-changelog --hide-credit --overwrite",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rimraf dist coverage .nyc_output",
    "clean:deps": "rimraf node_modules package-lock.json",
    "commit": "cz",
    "config:env": "node -e \"console.log('Environment:', process.env.NODE_ENV || 'development'); console.log('Port:', process.env.PORT || 4444);\"",
    "config:show": "node -e \"console.log(JSON.stringify(require('./config'), null, 2));\"",
    "config:validate": "node -e \"require('./config'); console.log('Configuration loaded successfully');\"",
    "coverage": "vitest run --coverage",
    "db:connect": "node -e \"require('./config/db').connectDB()\"",
    "db:migrate": "node scripts/migrate-db.js",
    "db:migrate:status": "node scripts/check-migration-status.js",
    "db:migrate:up": "node scripts/run-migrations.js",
    "db:models:generate": "node scripts/generate-models.js",
    "db:reset": "node scripts/reset-db.js",
    "db:schema:dump": "node scripts/dump-schema.js",
    "db:seed": "node scripts/run-seeds.js",
    "db:seed:run": "node scripts/seed-database.sh",
    "dev": "node --watch app.js",
    "dev:debug": "node --inspect app.js",
    "dev:watch": "node --watch app.js",
    "docker:build": "docker build -t wikiagora .",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:run": "docker run -p 4444:4444 wikiagora",
    "docker:stop": "docker-compose down",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:serve": "vitepress serve docs",
    "export": "node scripts/export-data.js",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "import": "node scripts/import-data.js",
    "install:clean": "npm run clean:deps && npm install",
    "licenses": "npx license-checker --production --onlyAllow=\"MIT;ISC;BSD-3-Clause;Apache-2.0\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint-ci": "biome ci .",
    "lt": "npx localtunnel --port 4444",
    "monitor": "pm2 start app.js --name wikiagora",
    "monitor:logs": "pm2 logs wikiagora",
    "monitor:restart": "pm2 restart wikiagora",
    "monitor:status": "pm2 status",
    "monitor:stop": "pm2 stop wikiagora",
    "ngrok": "ngrok http 4444",
    "openapi:bundle": "node openapi/scripts/bundle.js",
    "openapi:export": "npx redoc-cli build openapi/openapi.yaml",
    "openapi:serve": "npx redoc-cli serve openapi/openapi.yaml",
    "openapi:validate": "npx @apidevtools/swagger-cli validate openapi/openapi.yaml",
    "pre-commit": "lint-staged",
    "prepare": "husky install",
    "prod": "pm2 start app.js --name wikiagora --env production",
    "prod:logs": "pm2 logs wikiagora",
    "prod:restart": "pm2 restart wikiagora",
    "prod:status": "pm2 status",
    "prod:stop": "pm2 stop wikiagora",
    "release": "release-it",
    "release:major": "release-it major",
    "release:minor": "release-it minor",
    "release:patch": "release-it patch",
    "security": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "seed": "node scripts/seed-database.sh",
    "size": "size-limit",
    "sort": "npx sort-package-json",
    "spell": "cspell --cache --gitignore \"**/*.{ts,js,md,json,yml}\"",
    "start": "node --watch app.js",
    "syncpack": "syncpack list-mismatches",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config ./vitest.integration.config.js",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --typecheck.enabled=false",
    "test:watch": "vitest",
    "todo": "node scripts/checklist.js",
    "validate": "concurrently \"npm:lint\" \"npm:format:check\" \"npm:test\"",
    "validate:ci": "concurrently \"npm:lint\" \"npm:format:check\" \"npm:test:coverage\""
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@bwip-js/node": "^4.8.0",
